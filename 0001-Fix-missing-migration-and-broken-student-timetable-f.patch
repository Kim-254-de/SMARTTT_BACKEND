 apps/schedule/services.py                      |  8 ++++----
 .../0003_timetableslot_lecturer_name_text.py   | 18 ++++++++++++++++++
 apps/timetable/models/timetable.py             |  8 ++++++++
 4 files changed, 31 insertions(+), 5 deletions(-)
 create mode 100644 apps/timetable/migrations/0003_timetableslot_lecturer_name_text.py

diff --git a/apps/notifications/migrations/0002_classreminderdelivery_and_automated_sender.py b/apps/notifications/migrations/0002_classreminderdelivery_and_automated_sender.py
