DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=nextup.co.ke,www.nextup.co.ke,localhost
POSTGRES_DB=smarttt_db
POSTGRES_USER=smarttt_user
POSTGRES_PASSWORD=choose_a_strong_database_password_here
POSTGRES_HOST=db
POSTGRES_PORT=5432
CORS_ALLOWED_ORIGINS=https://smart-timetable-8f116.web.app
CSRF_TRUSTED_ORIGINS=https://nextup.co.ke,https://www.nextup.co.ke
FRONTEND_RESET_PASSWORD_URL=https://smart-timetable-8f116.web.app/reset-password
DEFAULT_FROM_EMAIL=noreply@nextup.co.ke

# --- Smart Attendance: push rescheduled classes ---
# The attendance backend's base URL. With ATTENDANCE_API_KEY set, a rescheduled
# class is sent to it straight away. Leave empty to turn the push off.
ATTENDANCE_BASE_URL=

# --- Timetable Allocator and Timetable Generator ---
# One shared key per system, sent as X-API-Key. Generate each with
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Empty = that system's /api/v1/integrations/<system>/ endpoints refuse everything.
ALLOCATOR_API_KEY=
GENERATOR_API_KEY=
# Django auth group for the Directorate of Examinations and Timetabling.
TIMETABLING_OFFICE_GROUP=timetabling_office
