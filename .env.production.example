# =================================================================
# SMARTTT Backend - Production Environment Variables
# =================================================================

# --- Django Core Settings ---
DJANGO_SETTINGS_MODULE=config.settings.production
# Generate a secret key with: python -c 'import secrets; print(secrets.token_urlsafe(50))'
DJANGO_SECRET_KEY=change-this-to-a-very-long-and-secure-random-string
DJANGO_DEBUG=False
# Comma-separated list of domains/IPs allowed to reach this backend
DJANGO_ALLOWED_HOSTS=nextup.co.ke,www.nextup.co.ke,localhost,127.0.0.1

# --- PostgreSQL Database ---
POSTGRES_DB=smarttt_db
POSTGRES_USER=smarttt_user
POSTGRES_PASSWORD=choose_a_strong_database_password_here
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Security, CORS & CSRF ---
# Allowed frontend origins
CORS_ALLOWED_ORIGINS=https://smart-timetable-8f116.web.app
CORS_ALLOW_ALL_ORIGINS=False
# Trusted CSRF origins
CSRF_TRUSTED_ORIGINS=https://nextup.co.ke,https://www.nextup.co.ke

# --- Email / Notifications (Resend) ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=587
EMAIL_HOST_USER=resend
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=noreply@nextup.co.ke

# --- Frontend Password Reset Redirect ---
FRONTEND_RESET_PASSWORD_URL=https://smart-timetable-8f116.web.app/reset-password

# --- University Portal Scraper URLs ---
PORTAL_URL=https://students.tharaka.ac.ke/
PORTAL_UNITS_URL=https://students.tharaka.ac.ke/pages/SemesterUnitsRegistration
