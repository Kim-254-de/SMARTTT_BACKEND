From 95cde6fae10e0aaab808c9feb9da91721923a460 Mon Sep 17 00:00:00 2001
From: Emmanuel Kimathi <kimathi@example.com>
Date: Sun, 30 Aug 2026 14:17:34 +0000
Subject: [PATCH 1/2] Add missing migration for User.preferred_language

This field was added to the User model in the last merge but its
migration was never generated or committed. Every query touching
User (login, register, profile, literally anything auth-related) was
one migrate away from breaking in production with:
'no such column: accounts_user.preferred_language'
(would surface the moment anyone ran migrate on a database that
didn't already have this column from some other path).
---
 .../migrations/0002_user_preferred_language.py | 18 ++++++++++++++++++
 1 file changed, 18 insertions(+)
 create mode 100644 apps/accounts/migrations/0002_user_preferred_language.py

diff --git a/apps/accounts/migrations/0002_user_preferred_language.py b/apps/accounts/migrations/0002_user_preferred_language.py
new file mode 100644
index 0000000..ae8c8e7
--- /dev/null
+++ b/apps/accounts/migrations/0002_user_preferred_language.py
@@ -0,0 +1,18 @@
+# Generated by Django 5.1 on 2026-08-30 14:15
+
+from django.db import migrations, models
+
+
+class Migration(migrations.Migration):
+
+    dependencies = [
+        ('accounts', '0001_initial'),
+    ]
+
+    operations = [
+        migrations.AddField(
+            model_name='user',
+            name='preferred_language',
+            field=models.CharField(choices=[('en', 'English'), ('sw', 'Swahili'), ('fr', 'French')], default='en', max_length=5),
+        ),
+    ]
-- 
